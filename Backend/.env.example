# AI Stylist Backend Environment Variables

# LLM API Configuration
# --------------------

# Hugging Face Inference API (default)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Ollama (local LLM option)
# OLLAMA_MODEL=llama2:7b

# OpenAI-compatible API (e.g., LocalAI, LM Studio, etc.)
# OPENAI_COMPATIBLE_URL=http://localhost:8080/v1/chat/completions
# OPENAI_COMPATIBLE_KEY=

# Weather API
# ----------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Storage Configuration
# --------------------
# STORAGE_DIR=data  # Default is 'data' under the backend directory